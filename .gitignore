# Xcode Swift Package Manager state — ignore everything EXCEPT Package.resolved,
# which must be committed so Xcode Cloud (auto-resolution disabled) can build.
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
data/area-assign-review.json

# Fastlane build output + downloaded signing material (secrets — never commit)
