<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup opt-out. Companion to android:allowBackup="false"
     in AndroidManifest.xml. Disables both cloud backup and device-to-device
     transfer so auth tokens stored by Capacitor / WebView aren't included
     in adb backups or migrated to other devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
