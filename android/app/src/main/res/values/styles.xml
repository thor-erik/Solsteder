<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Light status bar = DARK system icons (battery/clock/wifi). The app
             is a uniformly light (cream) theme over a light map, so the default
             white icons were invisible. windowLightStatusBar makes them dark.
             (Android API 23+; the S25 and all target devices qualify.) -->
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ SplashScreen API: cream background + the launcher icon
             (Shades mark), auto-centred and system-sized small — matching the
             iOS cream + small-mark splash. @capacitor/splash-screen holds this
             until JS hands off to the web loader. The legacy full-screen
             @drawable/splash is kept only for Android < 12. -->
        <item name="windowSplashScreenBackground">@color/shades_cream</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>